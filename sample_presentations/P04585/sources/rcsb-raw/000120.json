D MINIMIZED STRUCTURES.  ONLY THESE\nCOORDINATES ARE LISTED.  THE FIRST CHAIN IS THE N-TERMINAL\nDOMAIN, AND THE SECOND IS THE C-TERMINAL DOMAIN.\n\nTHE FIELD PRESENTED IN COLUMNS 61 - 66 IN THIS COORDINATE\nFILE REPRESENTS THE ATOMIC RMS DEVIATION OF THE INDIVIDUAL\nSTRUCTURES ABOUT THE MEAN COORDINATE POSITIONS FOR EACH\nDOMAIN.\n\nTHE COORDINATES OF THE TWO DOMAINS HAVE BEEN BEST FITTED TO\nEACH OTHER.","software_ordinal":1}],"pdbx_vrpt_summary":{"attempted_validation_steps":"mogul,molprobity,validation-pack,coreclust,chemicalshiftanalysis,validation_schema,percentiles,writepdf,writexml,writecif","ligands_for_buster_report":"N","report_creation_date":"2026-03-05T23:08:00.000+00:00"},"pdbx_vrpt_summary_geometry":[{"angles_RMSZ":1.67,"bonds_RMSZ":1.86,"clashscore":39.22,"clashscore_full_length":39.22,"num_H_reduce":235,"num_angles_RMSZ":358,"num_bonds_RMSZ":276,"percent_ramachandran_outliers":12.9,"percent_ramachandran_outliers_full_length":12.9,"percent_rotamer_outliers":31.03,"percent_rotamer_outliers_full_length":31.03}],"rcsb_accession_info":{"deposit_date":"1991-11-27T00:00:00.000+00:00","has_released_experimental_data":"N","initial_release_date":"1993-10-31T00:00:00.000+00:00","major_revision":1,"minor_revision":4,"revision_date":"2024-05-01T00:00:00.000+00:00","status_code":"REL"},"rcsb_entry_container_identifiers":{"assembly_ids":["1"],"entity_ids":["1","2","3"],"entry_id":"1NCP","model_ids":[1],"non_polymer_entity_ids":["3"],"polymer_entity_ids":["1","2"],"pubmed_id":1959614,"rcsb_id":"1NCP"},"rcsb_entry_info":{"assembly_count":1,"branched_entity_count":0,"cis_peptide_count":0,"deposited_atom_count":275,"deposited_branched_entity_instance_count":0,"deposited_deuterated_water_count":0,"deposited_hydrogen_atom_count":259,"deposited_model_count":1,"deposited_modeled_polymer_monomer_count":35,"deposited_nonpolymer_entity_instance_count":2,"deposited_polymer_entity_instance_count":2,"deposited_polymer_monomer_count":35,"deposited_solvent_atom_count":0,"deposite