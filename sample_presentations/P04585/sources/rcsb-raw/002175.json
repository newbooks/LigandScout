mula_weight":670.841,"name":"Saquinavir","prd_id":"PRD_000454","release_status":"REL","represent_as":"single molecule","representative_PDB_id_code":"1hxb","type":"Peptide-like"},"pdbx_reference_molecule_annotation":[{"family_prd_id":"FAM_000327","ordinal":1,"prd_id":"PRD_000454","source":"PMID:1956054","text":"Inhibitor of HIV-1 PROTEASE, EC: 3.4.23.16","type":"Function"},{"family_prd_id":"FAM_000327","ordinal":2,"prd_id":"PRD_000454","source":"KEGG","text":"Antiviral activity [HIV protease inhibitor]","type":"Function"},{"family_prd_id":"FAM_000327","ordinal":3,"prd_id":"PRD_000454","source":"DrugBank","text":"protease inhibitor with activity against Human Immunodeficiency Virus Type 1 (HIV-1)","type":"Function"},{"family_prd_id":"FAM_000327","ordinal":4,"prd_id":"PRD_000454","source":"Wikipedia","text":"antiretroviral drug used in HIV therapy. It falls in the protease inhibitor class.","type":"Function"},{"family_prd_id":"FAM_000327","ordinal":5,"prd_id":"PRD_000454","source":"DrugBank","text":"An HIV protease inhibitor which acts as an analog of an HIV protease cleavage site. It is a highly specific inhibitor of HIV-1 and HIV-2 proteases. (Description, from PubChem)","type":"Function"},{"family_prd_id":"FAM_000327","ordinal":6,"prd_id":"PRD_000454","source":"DrugBank","text":"Saquinavir is a protease inhibitor with activity against Human Immunodeficiency Virus Type 1 (HIV-1). Protease inhibitors block the part of HIV called protease. HIV-1 protease is an enzyme required for the proteolytic cleavage of the viral polyprotein precursors into the individual functional proteins found in infectious HIV-1. Saquinavir binds to the protease active site and inhibits the activity of the enzyme. This inhibition prevents cleavage of the viral polyproteins resulting in the formation of immature non-infectious viral particles. Protease inhibitors are almost always used in combination with at least two other anti-HIV drugs. (Pharmacodynamics)","type":"pharmacological action"},{"family_prd_id":"FAM_000327","ordinal":7,"prd_id":"PRD_000454","source":"DrugBank","text":"Saquinavir inhibits the HIV viral proteinase enzyme which prevents cleavage of the gag-pol polyprotein, resulting in noninfectious, immature viral particles. (Mechanism of action)","type":"Mechanism of action"}],"pdbx_reference_molecule_family":{"family_prd_id":"FAM_000327","name":"SAQUINAVIR","release_status":"REL"},"pdbx_reference_molecule_features":[{"family_prd_id":"FAM_000327","ordinal":1,"prd_id":"PRD_000454","source":"MeSH","source_ordinal":1,"type":"MeSH_Unique_ID","value":"D019258"},{"family_prd_id":"FAM_000327","ordinal":2,"prd_id":"PRD_000454","source":"Merck","source_ordinal":1,"type":"External_reference_ID","value":"14:8369"},{"family_prd_id":"FAM_000327","ordinal":3,"prd_id":"PRD_000454","source":"Beilstein","source_ordinal":1,"type":"External_reference_ID","value":"5469491"},{"family_prd_id":"FAM_000327","ordinal":4,"prd_id":"PRD_000454","source":"KEGG","source_ordinal":1,"type":"KEGG_Compound_ID","value":"C07243"},{"family_prd_id":"FAM_000327","ordinal":5,"prd_id":"PRD_000454","source":"KEGG","source_ordinal":1,"type":"KEGG_Drug_ID","value":"D00429"},{"family_prd_id":"FAM_000327","ordinal":6,"prd_id":"PRD_000454","source":"DrugBank","source_ordinal":1,"type":"External_reference_ID","value":"DB01232"},{"family_prd_id":"FAM_000327","ordinal":7,"prd_id":"PRD_000454","source":"ATC","source_ordinal":1,"type":"External_reference_ID","value":"J05AE01"},{"family_prd_id":"FAM_000327","ordinal":8,"prd_id":"PRD_000454","source":"PubChem","source_ordinal":1,"type":"External_reference_ID","value":"7847495"},{"family_prd_id":"FAM_000327","ordinal":9,"prd_id":"PRD_000454","source":"ChemSpider","source_ordinal":1,"type":"External_reference_ID","value":"390016"},{"family_prd_id":"FAM_000327","ordinal":10,"prd_id":"PRD_000454","source":"ChemDB","source_ordinal":1,"type":"External_reference_ID","value":"6047394"},{"family_prd_id":"FAM_000327","ordinal":11,"prd_id":"PRD_000454","so